@import "../omarchy/current/theme/waybar.css";

* {
  background-color: transparent;
  color: #FFF;

  border: none;
  border-radius: 0;
  margin: 0;
  min-height: 0;
  font-family: 'CaskaydiaMono Nerd Font';
  font-size: 12px;
}

.modules-left {
  margin-left: 8px;
}

.modules-right {
  margin-right: 8px;
}

#workspaces button {
  all: initial;
  padding: 0 6px;
  margin: 0 1.5px;
  min-width: 9px;
}

#workspaces button.empty {
  opacity: 0.5;
}

#cpu,
#clock,
#battery,
#pulseaudio,
#bluetooth,
#network {
  min-width:10px;
  margin-left:15px;
}

#network {
  margin-left:12px;
  padding:0px 3px 0px 0px;
}


#custom-omarchy, 
#custom-files {
  margin-right: 16px;
}


#custom-update {
  font-size: 10px;
}

.hidden {
  opacity: 0;
}

#custom-screenrecording-indicator {
  min-width: 12px;
  margin-left: 8.75px;
  font-size: 10px;
}

#custom-screenrecording-indicator.active {
  color: #a55555;
}
